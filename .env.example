# Demo is deterministic and safe for local onboarding. Use production for live users.
RUNTIME_MODE=demo
ENVIRONMENT=development
RUNTIME_IMAGE=agentic-cicd-pipeline-runtime:local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql+psycopg2://agent_user:agent_pass_dev@postgres:5432/agentic_cicd
REDIS_URL=redis://redis:6379/0

# mock is demo/CI only. Production must use http or mcp.
TOOL_BACKEND=mock
TOOL_HTTP_BASE_URL=
TOOL_MCP_ENDPOINT=
TOOL_TIMEOUT_SECONDS=10
TOOL_RETRIES=1

# deterministic is demo/CI only. Production should use openai or anthropic.
EVAL_JUDGE_PROVIDER=deterministic
EVAL_JUDGE_MODEL=
SLACK_WEBHOOK_URL=
RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=8000
