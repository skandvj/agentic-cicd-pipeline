{
  "version": 2,
  "functions": {
    "app.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/app.py" },
    { "source": "/metrics", "destination": "/app.py" },
    { "source": "/docs", "destination": "/app.py" },
    { "source": "/openapi.json", "destination": "/app.py" },
    { "source": "/v1/(.*)", "destination": "/app.py" },
    { "source": "/api/(.*)", "destination": "/app.py" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
